# Application
APP_NAME=AgriTwin API
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=agritwin_dev
DB_USER=postgres
DB_PASSWORD=your_postgresql_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Multi-agent integrations (optional)
# Open-Meteo is used without an API key.
GOOGLE_MAPS_API_KEY=
DATA_GOV_IN_API_KEY=
# Current Agmarknet resource ID from data.gov.in.
AGMARKNET_RESOURCE_ID=

# Optional platform defaults
DEFAULT_STATE=Maharashtra
DEFAULT_DISTRICT=Nashik

# Uploaded multi-agent chat system (Groq; keep the key private)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Multi-agent Market Agent (daily OGD / AGMARKNET observations)
DATA_GOV_API_KEY=
MARKET_CACHE_TTL_SECONDS=300
MARKET_HISTORY_BACKFILL_DAYS=365

# Optional routing provider and estimated logistics cost inputs (INR)
LOGISTICS_FUEL_PRICE_INR_PER_LITER=95
LOGISTICS_DRIVER_COST_INR_PER_HOUR=250
LOGISTICS_HANDLING_COST_INR_PER_TON=150
LOGISTICS_ESTIMATED_TOLLS_INR=0
